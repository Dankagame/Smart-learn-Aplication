# PostgreSQL database credentials and database name
POSTGRES_USER=smartlearn_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=smartlearn_db

# Docker Compose builds DATABASE_URL for the backend from the values above, pointing at the db service:
# DATABASE_URL=postgresql+psycopg://smartlearn_user:your_secure_password_here@db:5432/smartlearn_db

# Backend application configuration
APP_NAME=SmartLearn API
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://localhost:80
