# ==============================================================================
# SmartLearn - Docker Build Ignore File (.dockerignore)
# Excludes unnecessary build artifacts, secrets, and caches from Docker contexts
# ==============================================================================

# Version control
.git
.gitignore
.github

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.coveragerc

# Virtual environments
venv/
.venv/
env/
ENV/

# Secrets and local environment files (never bake secrets into images)
.env
.env.*
!.env.example

# IDEs and local editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System artifacts
.DS_Store
Thumbs.db
ehthumbs.db

# Node.js, logs, and temporary files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
scratch/
*.log
*.tmp
dev-server.js
